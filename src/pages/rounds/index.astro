---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import Avatar from '../../components/Avatar.astro';
import {rounds,standings,formatDate,formatScore} from '../../data/game';
---
<Layout title="Past rounds"><section class="page-intro"><div><div class="eyebrow"><span class="little-line"></span> THE VOYAGE LOG</div><h1>Good guesses. Great memories<span class="accent">.</span></h1><p>{rounds.length ? 'A little time travel through our weekly voyages.' : 'Every voyage will be logged here.'}</p></div><span class="season-label">{rounds.length} {rounds.length===1?'ROUND':'ROUNDS'} & COUNTING</span></section>{rounds.length===0 && <section class="empty-panel"><span class="note-icon">✦</span><div><h2>No rounds in the log yet</h2><p>Once the first round is complete, its results and destinations will show up here.</p></div><a class="button button-outline" href="/">Back to the leaderboard<Icon size={17}/></a></section>}<div class="archive-grid">{rounds.map((round,i)=>{const winner=standings(round)[0];return <article class="archive-card"><a href={`/rounds/${round.number}`}><div class="archive-photo"><img src={round.photos[0]?.image ?? "/images/rounds/round-2-placeholder.svg"} alt={round.photos[0]?.alt ?? ""} loading={i<2?'eager':'lazy'} width="800" height="450"/><span class="pill">{i===0?'LATEST ROUND':`ROUND ${round.number}`}</span></div><div class="archive-body"><div class="eyebrow">ROUND {round.number} {round.date && <><span> / </span> {formatDate(round.date)}</>}</div><h2>{round.title}</h2><p>{round.results.length ? `${round.results.length} curious shipmates` : 'In progress · results coming soon'}</p>{winner && <div class="archive-winner"><Avatar player={winner.player}/><span><small>THIS WEEK’S WINNER</small>{winner.player.name}</span><strong>{formatScore(winner.score)}<small> points</small></strong><Icon/></div>}</div></a></article>})}</div></Layout>
