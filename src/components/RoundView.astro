---
import {standings,formatScore,formatDate,rankLabel,type Round} from '../data/game';
import Icon from './Icon.astro';
import Avatar from './Avatar.astro';
import PhotoCard from './PhotoCard.astro';
interface Props {round:Round; latest?:boolean}
const {round,latest=false}=Astro.props;
const ranked=standings(round);
const podium=[
  {entry:ranked[1],cls:'second',label:'SO CLOSE!',place:2},
  {entry:ranked[0],cls:'first',label:'WORLD CLASS',place:1},
  {entry:ranked[2],cls:'third',label:'NICE GUESSING',place:3},
].filter(item=>item.entry);
const portCount=round.photos.length;
---
<section class="page-intro"><div><div class="eyebrow"><span class="little-line"></span> OUR WEEKLY WORLD CRUISE</div><h1>A world of guesses.<br class="mobile-break"/> A little friendly rivalry<span class="accent">.</span></h1><p>One world to explore. A new destination to share. Every guess brings us closer to shore.</p></div><div class="edition-stamp"><Icon name="anchor" size={30}/><span>EXPLORE. GUESS. SAIL ON.</span></div></section>
<section class="round-hero" aria-labelledby="round-title"><img class="hero-photo" src={round.photos[0]?.image ?? "/images/rounds/round-2-placeholder.svg"} alt={round.photos[0]?.alt ?? ""} fetchpriority="high" width="1600" height="900"/><div class="hero-shade"></div><div class="hero-content"><span class="pill"><span class="status-dot"></span>{latest?'LATEST ROUND':'FROM THE ARCHIVE'}</span><p class="hero-meta">ROUND {round.number}{round.date && <><span> / </span>{formatDate(round.date)}</>}</p><h2 id="round-title">{round.title}</h2>{round.description && <p class="hero-description">{round.description}</p>}<a class="button" href={latest && round.gameUrl ? round.gameUrl : '#results'}>{latest && round.gameUrl ? 'Play this round' : 'See round results'}<Icon size={17}/></a></div>{round.photos.length > 0 && <><div class="hero-location"><Icon name="pin" size={16}/>{round.photos[0].country}{round.photos[0].year && <><span> • </span>{round.photos[0].year}</>}</div><div class="hero-index">01 <span>/ {String(round.photos.length).padStart(2, '0')}</span></div></>}</section>
<div class="round-facts"><span><Icon name="calendar" size={17}/>Every week, a new voyage</span><div>{round.photos.length > 0 && <span><Icon name="photo" size={17}/>{round.photos.length} destinations</span>}<span><Icon name="people" size={17}/>{round.results.length} players</span><span><Icon name="globe" size={17}/>One curious crew</span></div></div>
{ranked.length===0 ? <section class="empty-panel" id="results"><span class="note-icon">✦</span><div><h2>No results yet</h2><p>Scores for this round will appear here once they are in.</p></div></section> : <div class="results-grid" id="results"><section class="podium-panel"><div class="section-heading"><h2>This week’s explorers</h2><span class="handwritten">A round of applause ↴</span></div><div class="podium">{podium.map(({entry,cls,label,place})=><div class={`podium-person ${cls}`}>{place===1&&<span class="crown" aria-label="Winner">♛</span>}<Avatar player={entry.player} large/><strong>{entry.player.name.split(' ')[0]}</strong><span>{formatScore(entry.score)} pts</span><div class="podium-block">{place===1&&<Icon name="trophy" size={28}/>}<span>{place}</span><small>{label}</small></div></div>)}</div><div class="podium-caption">A good eye. A lucky guess. A well-earned spot.</div></section>
<section class="standings-panel"><div class="section-heading"><h2>Round {round.number} Leaderboard</h2><span class="subtle">Round {round.number}</span></div><div class="table-scroll"><table class="weekly-table"><caption class="sr-only">Round {round.number} scores</caption><thead><tr><th scope="col">RANK</th><th scope="col">PLAYER</th><th scope="col">📍 LOCATION</th><th scope="col">🗓️ YEAR</th><th scope="col">⚡ TOTAL</th></tr></thead><tbody>{ranked.map((r,i)=><tr><td><span class:list={['rank',{'winner-rank':i===0}]}>{rankLabel(ranked.map(result=>result.score),i)}</span></td><th scope="row"><Avatar player={r.player}/><span>{r.player.name}</span>{i===0&&<span class="winner-spark">✦</span>}</th><td>{r.location ?? '–'}</td><td>{r.year ?? '–'}</td><td>{formatScore(r.score)}</td></tr>)}</tbody></table></div><a class="text-link standings-link" href="/">See the all-time leaderboard<Icon size={17}/></a></section></div>}
{round.photos.length > 0 && <section class="photos-section"><div class="section-heading"><div><div class="eyebrow">THE STORIES BEHIND THE GUESSES</div><h2>{portCount} {portCount===1?'port of call':'ports of call'}. Stories from our crew.</h2></div><a class="text-link" href="/gallery">Explore the gallery<Icon size={17}/></a></div><p class="table-note">Made your guesses? Reveal the stories our shipmates shared.</p><div class="photo-grid">{round.photos.map((photo,index)=><PhotoCard photo={photo} index={index}/>)}</div></section>}
<section class="bottom-note"><span class="note-icon">✦</span><div><h2>It’s a big world. Let’s keep guessing.</h2><p>A little curiosity, a bit of competition, and a new voyage every week.</p></div><a class="button button-outline" href="/rounds">Browse the voyage log<Icon size={17}/></a></section>
